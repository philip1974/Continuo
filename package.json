{
  "name": "continuo",
  "version": "0.2.15",
  "description": "Open-source GUI substrate for terminal-native agents (Claude Code, Codex CLI, Aider, etc.)",
  "keywords": [
    "agent",
    "mcp",
    "terminal",
    "electron",
    "plugin",
    "claude-code",
    "codex"
  ],
  "homepage": "https://github.com/philip1974/Continuo",
  "bugs": {
    "url": "https://github.com/philip1974/Continuo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/philip1974/Continuo.git"
  },
  "license": "MIT",
  "author": "philip1974",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:pack": "node scripts/fetch-debug-adapter.mjs && cross-env BUILD_TARGET=pack electron-vite build",
    "build:app": "pnpm check:sibling-ref && pnpm build:pack && electron-builder && pnpm check:secrets:pack",
    "build:app:mac": "pnpm check:sibling-ref && pnpm build:pack && electron-builder --mac && pnpm check:secrets:pack",
    "build:app:win": "pnpm check:sibling-ref && pnpm build:pack && electron-builder --win && pnpm check:secrets:pack",
    "build:app:linux": "pnpm check:sibling-ref && pnpm build:pack && electron-builder --linux && pnpm check:secrets:pack",
    "check:sibling-ref": "node scripts/check-sibling-ref.mjs",
    "check:secrets:pack": "node scripts/check-no-secrets.mjs out-pack --packaged dist-electron",
    "relaunch": "bash scripts/relaunch.sh",
    "preview": "electron-vite preview",
    "postinstall": "install-electron && electron-rebuild --only node-pty",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "pretest": "node scripts/check-no-skip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit --project milkdown-patched",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "bdd:index": "node scripts/bdd-index.mjs",
    "rebuild:native": "electron-rebuild --only node-pty"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.13.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@continuo-terminal/host": "file:../ContinuoTerminal/packages/host",
    "@continuo-terminal/protocol": "file:../ContinuoTerminal/packages/protocol",
    "@continuo-terminal/react-terminal": "file:../ContinuoTerminal/packages/react-terminal",
    "@continuo-terminal/server-node": "file:../ContinuoTerminal/packages/server-node",
    "@continuo-terminal/shell-quote": "file:../ContinuoTerminal/packages/shell-quote",
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@react-symbols/icons": "^1.3.1",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dockview-react": "^6.0.0",
    "dompurify": "^3.4.18",
    "iconv-lite": "^0.7.3",
    "ignore": "^7.0.5",
    "katex": "^0.19.1",
    "mermaid": "^11.17.2",
    "motion": "12.38.0",
    "node-pty": "1.2.0-beta.18",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^24"
  },
  "pnpm": {
    "overrides": {
      "tinypool@<2.1.2": "^2.1.2",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "brace-expansion@>=1 <1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "undici@>=7 <7.30.1": "^7.30.1",
      "node-pty": "1.2.0-beta.18"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  }
}
